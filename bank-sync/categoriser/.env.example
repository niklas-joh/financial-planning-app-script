# Copy to .env (git-ignored) and adjust. Never commit .env.

# "Bank Sync" Google Sheet
SPREADSHEET_ID=1C9Jlvvz1_r8c323sk1Gsktdgq2Gq7hxUCDZ4o-jCEEM

# Service-account JSON key. Relative paths resolve against categoriser/.
# In Docker this is overridden to /app/credentials/service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Sheet names
TRANSACTIONS_SHEET=transactions
OUTPUT_SHEET=categorised
ISSUES_SHEET=categoriser_issues
RULES_SHEET=categoriser_rules
TAXONOMY_SHEET=categoriser_taxonomy

# Owner value of shared accounts in the `owner` column of `transactions`.
JOINT_OWNER=common

# Legacy "Financial Planning" sheet with hand-labelled history. Read only; used by
# `categoriser.mine`, `categoriser.evaluate` and `categoriser.seed_taxonomy`, never by the daily run.
LEGACY_SPREADSHEET_ID=
