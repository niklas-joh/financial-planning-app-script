# Copied to ~/trade-republic/.env by scripts/install-schedule.sh (git-ignored, chmod 600). Never commit .env.
# The PIN is never stored: login.sh asks for it.

# Your Trade Republic phone number, international format.
TR_PHONE=+352000000000

# Account name on the Bank Sync tabs (and in its account id). Give a second person's export another name.
TR_ACCOUNT_NAME=Trade Republic

# Drive file id of trade-republic.csv in the Bank Sync CSV folder (from its URL: /file/d/<id>/view).
# Empty: the CSV is only written to data/ (upload it once to the folder, share it, then set the id).
TR_DRIVE_FILE_ID=

# After the first full read, each run re-reads this many days (pytr merges them into data/all_events.json).
TR_LOOKBACK_DAYS=45

# Booking dates are this zone's day (Bank Sync's clock).
TR_TIME_ZONE=Europe/Brussels
